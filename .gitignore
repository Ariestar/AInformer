# ── 机器产物：每次运行都会重建，不入库 ──────────────
data/*.json
data/*.jsonl
data/*.log

# ── 站点产物：由 web/ 构建与 build_feed.py 生成 ──────
# 需要把页面本身也纳入版本时，删掉下面一行即可
out/*

# ── 前端 ──────────────────────────────────────────
web/.astro/
web/public/data/
web/src/data/

# ── 依赖与缓存 ──────────────────────────────────
node_modules/
.wrangler/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# ── 系统杂项 ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 本地配置 ────────────────────────────────────
.env

# ── WorkBuddy 项目数据（内存/日志，不入库）─────────
.workbuddy-ai/
