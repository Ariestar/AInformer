# 复制为 .env 后按需修改。.env 不入库，CI 用仓库 secrets / variables。
# 敏感值（API token、密钥）只写在这里或 GitHub secrets，不要写进代码。

# ── 站点 ──────────────────────────────────────────
# feed 的 atom:link self 依赖它，没有默认值，缺失会直接报错
AINFORMER_BASE_URL=https://ainformer.pages.dev
AINFORMER_SITE_NAME=AI 情报池
AINFORMER_SITE_DESC=由 AInformer 从多个一手源与中文源聚合而成。不做重要性筛选，只按时间排序。
AINFORMER_BRAND=AInformer

# ── 部署 ──────────────────────────────────────────

# ── feed 输出 ─────────────────────────────────────
AINFORMER_FEED_LIMIT=100
AINFORMER_FEED_PER_SOURCE=10

# ── 抓取 ──────────────────────────────────────────
AINFORMER_USER_AGENT=ainformer/1.0

# ── 判断层（可选，缺 key 时 triage.py 会拒绝运行）────
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── 部署凭据（敏感，只同步到 GitHub secrets，不进代码）──
# Cloudflare Dashboard → My Profile → API Tokens
# 权限：Account → Cloudflare Pages → Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
